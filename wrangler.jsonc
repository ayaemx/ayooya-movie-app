{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ayooya",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The React build is served from the same origin as the API, so session
  // cookies stay first-party and one set of security headers covers everything.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ayooya",
      // Database ids are identifiers, not secrets — safe to commit
      "database_id": "be5d8409-944c-4757-b8c1-6deac0f39131",
      "migrations_dir": "./migrations",
    },
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ALLOWED_ORIGINS": "",
  },
  // Secrets (never committed) — set with `npx wrangler secret put <NAME>`:
  //   TMDB_API_KEY   your TMDB v3 key
  //   ADMIN_TOKEN    long random string that unlocks GET /api/stats
}
